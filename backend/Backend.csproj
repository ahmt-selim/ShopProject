<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <!-- Çalışma anında değişen dosyalar (yüklenen resimler, sqlite, loglar) watch'u tetiklemesin -->
  <ItemGroup>
    <Watch Remove="wwwroot\uploads\**" />
    <Watch Remove="logs\**" />
    <Watch Remove="*.db" />
    <Watch Remove="*.db-shm" />
    <Watch Remove="*.db-wal" />
  </ItemGroup>

</Project>
