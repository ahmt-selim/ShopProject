<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b2e41690-4d28-4740-9c8b-01145e0e5eea</UserSecretsId>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Iyzipay" Version="2.1.80" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Çalışma anında değişen dosyalar (yüklenen resimler, sqlite, loglar) watch'u tetiklemesin -->
  <ItemGroup>
    <Watch Remove="wwwroot\uploads\**" />
    <Watch Remove="logs\**" />
    <Watch Remove="*.db" />
    <Watch Remove="*.db-shm" />
    <Watch Remove="*.db-wal" />
  </ItemGroup>

</Project>
