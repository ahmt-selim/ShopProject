    "Name" TEXT NOT NULL,
    "MappingsJson" TEXT NOT NULL,
    "StartRow" INTEGER NOT NULL,
    "CreatedAt" TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS "Carts" (
