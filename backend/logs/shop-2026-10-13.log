    "ItemsCount" INTEGER NOT NULL,
    "Subtotal" TEXT NOT NULL,
    "Shipping" TEXT NOT NULL,
    "Total" TEXT NOT NULL,
    "Status" TEXT NOT NULL,
    "CreatedAt" TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS "OrderItems" (
